# Application Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Supabase Configuration (Public - safe for browser)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role (Server-only - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay Configuration
# Get these from https://dashboard.razorpay.com/
# Use Test Mode credentials for development, Live Mode for production
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Note: RAZORPAY_KEY_ID will be exposed to the browser for Razorpay Checkout
# RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET must remain server-only

# Email Provider (Choose one: Resend, SendGrid, AWS SES)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=your_email_api_key
EMAIL_FROM_ADDRESS=hello@mivo.in
EMAIL_FROM_NAME=MIVO

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.stl,.3mf,.step,.stp,.pdf,.jpg,.jpeg,.png

# Rate Limiting (requests per window per IP)
RATE_LIMIT_QUOTE_REQUESTS=5
RATE_LIMIT_QUOTE_WINDOW_MINUTES=15
RATE_LIMIT_CONTACT_REQUESTS=3
RATE_LIMIT_CONTACT_WINDOW_MINUTES=15

# Error Tracking (Optional - Sentry, etc.)
# SENTRY_DSN=your_sentry_dsn
# SENTRY_ENVIRONMENT=development
